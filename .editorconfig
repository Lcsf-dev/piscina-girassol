# Mantém a mesma formatação ao abrir o projeto em editores diferentes.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# Preserva espaços intencionais na documentação Markdown.
[*.md]
trim_trailing_whitespace = false
